rules_version = '2';
// firestore.rules — who can read and write what in the database.
// Paste into Firebase Console → Firestore → Rules → Publish (or deploy with: npx firebase-tools deploy --only firestore:rules).
// Every field a customer can write is checked for type and size, so nobody can store huge, broken or harmful data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    // You are an admin if a document with your user ID exists in the "admins" collection.
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function counterPath() { return /databases/$(database)/documents/counters/orders; }

    // ---- small checks used below ----
    function str(v, max) { return v is string && v.size() <= max; }
    function optStr(m, key, max) { return !(key in m) || str(m[key], max); }
    function isPhone(v) { return v is string && v.matches('^[6-9][0-9]{9}$'); }
    function money(v) { return v is number && v >= 0 && v <= 1000000; }
    // customer photos and payment screenshots may only be images uploaded to Cloudinary
    function photoLink(v) { return v == '' || (v is string && v.size() <= 400 && v.matches('^https://res[.]cloudinary[.]com/[A-Za-z0-9_./,:%-]+$')); }

    // ---------- admin team ----------
    // admins/{uid}: role "owner" (you, added by hand in Firebase Console) or "admin" (joined with an invite link).
    function isOwner() {
      return signedIn() && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', '') == 'owner';
    }
    function invitePath(code) { return /databases/$(database)/documents/adminInvites/$(code); }
    // an invite link works once, for 15 minutes after the owner created it
    function inviteOpen(inv) { return inv.used == false && inv.createdAt + duration.value(15, 'm') > request.time; }

    match /admins/{uid} {
      allow get: if isMe(uid) || isOwner();
      allow list: if isOwner();
      // joining with a valid invite: becomes "admin" (never "owner") and the invite is used up in the same step
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['role', 'name', 'invite', 'addedAt'])
        && request.resource.data.role == 'admin'
        && str(request.resource.data.name, 60)
        && request.resource.data.addedAt == request.time
        && request.resource.data.invite is string
        && inviteOpen(get(invitePath(request.resource.data.invite)).data)
        && getAfter(invitePath(request.resource.data.invite)).data.usedBy == uid;
      // only the owner removes admins (and can never remove the owner entry)
      allow delete: if isOwner() && resource.data.get('role', '') != 'owner';
      allow update: if false;
    }

    match /adminInvites/{code} {
      // the invited person can open the invite only by its secret code (no browsing); the owner sees all
      allow get: if isOwner() || (signedIn() && inviteOpen(resource.data));
      allow list: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['name', 'createdBy', 'createdAt', 'used', 'usedBy'])
        && str(request.resource.data.name, 60) && request.resource.data.name.size() >= 2
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.used == false && request.resource.data.usedBy == ''
        && code.size() >= 32;
      // using it: only marks it used, by the person who joins, while they are added as admin
      allow update: if signedIn() && inviteOpen(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedAt'])
        && request.resource.data.used == true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.usedAt == request.time
        && existsAfter(/databases/$(database)/documents/admins/$(request.auth.uid));
      allow delete: if isOwner();
    }

    // ---------- shop: everyone sees active categories, products and reviews; only admins change them ----------
    match /categories/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---------- website texts and shop settings ----------
    match /content/site {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    // private settings (blood-sample mailing address): admins, and customers who placed a blood-art order
    match /settings/private {
      allow read: if isAdmin() || (signedIn() && exists(/databases/$(database)/documents/bloodAccess/$(request.auth.uid)));
      allow write: if isAdmin();
    }
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    // ---------- customers ----------
    match /users/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'createdAt', 'updatedAt'])
        && optStr(request.resource.data, 'name', 80)
        && optStr(request.resource.data, 'email', 120)
        && (!('phone' in request.resource.data) || request.resource.data.phone == '' || isPhone(request.resource.data.phone));
      allow delete: if false;
    }
    match /carts/{uid} {
      allow read: if isMe(uid);
      allow write: if isMe(uid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is list && request.resource.data.items.size() <= 50;
    }

    // ---------- order numbers: INV-1001, INV-1002 … (can only go up by one, together with a new order) ----------
    match /counters/orders {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == 1002
            && existsAfter(/databases/$(database)/documents/orders/INV-1001));
      allow update: if isAdmin()
        || (signedIn() && request.resource.data.keys().hasOnly(['next'])
            && request.resource.data.next == resource.data.next + 1
            && existsAfter(/databases/$(database)/documents/orders/$('INV-' + string(resource.data.next))));
      allow delete: if false;
    }

    // ---------- orders ----------
    function validCustomer(c) {
      return c is map
        && c.keys().hasOnly(['name', 'phone', 'address', 'landmark', 'city', 'pincode'])
        && str(c.name, 80) && c.name.size() >= 2
        && isPhone(c.phone)
        && optStr(c, 'address', 300) && optStr(c, 'landmark', 120) && optStr(c, 'city', 80)
        && (!('pincode' in c) || c.pincode == '' || (c.pincode is string && c.pincode.matches('^[1-9][0-9]{5}$')));
    }
    function validTotals(t) {
      return t is map
        && t.keys().hasOnly(['subtotal', 'discount', 'deliveryPacking', 'total', 'payNow', 'payLater', 'payAtPickup'])
        && money(t.total) && money(t.payNow)
        && (!('subtotal' in t) || money(t.subtotal))
        && (!('discount' in t) || money(t.discount))
        && (!('deliveryPacking' in t) || money(t.deliveryPacking))
        && (!('payLater' in t) || money(t.payLater))
        && (!('payAtPickup' in t) || money(t.payAtPickup));
    }
    // earlier payments must stay exactly as they were (a customer has at most 6 payments)
    function keepsOld(n, o) {
      return (o.size() < 1 || n[0] == o[0]) && (o.size() < 2 || n[1] == o[1]) && (o.size() < 3 || n[2] == o[2])
        && (o.size() < 4 || n[3] == o[3]) && (o.size() < 5 || n[4] == o[4]) && (o.size() < 6 || n[5] == o[5]);
    }
    // the one new payment a customer adds: their UTR, the amount, and optionally a Cloudinary screenshot
    function validPayment(p, o) {
      return p is map
        && p.keys().hasOnly(['stage', 'amount', 'utr', 'screenshot', 'at', 'verified'])
        && p.stage in ['first', 'balance']
        && p.amount is number && p.amount > 0 && p.amount <= o.totals.total
        && p.utr is string && p.utr.matches('^[0-9]{12}$')
        && p.verified == false
        && photoLink(p.get('screenshot', ''))
        && str(p.at, 40);
    }

    match /orders/{orderId} {
      // A customer creates their own order with the next number, status "Payment pending verification"
      // (or "Confirmed (pay at pickup)"), and no payments. Prices can't be fully checked here, so the
      // admin page recalculates every order from the products before it is marked paid.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'email', 'customer', 'items', 'method', 'payWhere', 'pincode', 'kind', 'hasBlood',
             'totals', 'status', 'payments', 'history', 'tracking', 'createdAt', 'updatedAt', 'number'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.number == getAfter(counterPath()).data.next - 1
        && orderId == 'INV-' + string(request.resource.data.number)
        && request.resource.data.status in ['Payment pending verification', 'Confirmed (pay at pickup)']
        && request.resource.data.payments.size() == 0
        && request.resource.data.tracking == ''
        && str(request.resource.data.email, 120)
        && validCustomer(request.resource.data.customer)
        && request.resource.data.items is list && request.resource.data.items.size() >= 1 && request.resource.data.items.size() <= 40
        && request.resource.data.method in ['home', 'pickup']
        && request.resource.data.payWhere in ['online', 'pickup']
        && request.resource.data.kind in ['retail', 'custom', 'blood', 'wholesale']
        && request.resource.data.hasBlood is bool
        && str(request.resource.data.pincode, 6)
        && validTotals(request.resource.data.totals)
        && request.resource.data.history is list && request.resource.data.history.size() == 1
        && str(request.resource.data.createdAt, 40) && str(request.resource.data.updatedAt, 40);

      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);

      // Customers may only ADD one unverified payment (their UTR). They can never change status, prices or totals.
      allow update: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['payments', 'updatedAt'])
            && resource.data.payments.size() < 6
            && request.resource.data.payments.size() == resource.data.payments.size() + 1
            && keepsOld(request.resource.data.payments, resource.data.payments)
            && validPayment(request.resource.data.payments[resource.data.payments.size()], resource.data)
            && str(request.resource.data.updatedAt, 40));

      allow delete: if isAdmin();
    }

    // Marks that this customer has a blood-art order (lets them read the sample mailing address).
    match /bloodAccess/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create, update: if isMe(uid)
        && request.resource.data.keys().hasOnly(['orderId'])
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.uid == uid
        && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.hasBlood == true;
      allow delete: if isAdmin();
    }

    // ---------- wholesale applications: one per customer; only admins approve ----------
    function validApplication(d) {
      return d.keys().hasOnly(['shopName', 'ownerName', 'phone', 'city', 'gst', 'status', 'createdAt'])
        && str(d.shopName, 100) && d.shopName.size() >= 2
        && str(d.ownerName, 80) && isPhone(d.phone) && str(d.city, 80)
        && optStr(d, 'gst', 20) && str(d.createdAt, 40);
    }
    match /wholesaleApplications/{uid} {
      allow read: if isMe(uid) || isAdmin();
      allow create: if isMe(uid) && request.resource.data.status == 'pending' && validApplication(request.resource.data);
      // a rejected shop may apply again (back to "pending"); everything else is the admin's job
      allow update: if isAdmin() || (isMe(uid) && resource.data.status == 'rejected' && request.resource.data.status == 'pending'
        && validApplication(request.resource.data));
      allow delete: if isAdmin();
    }

    // ---------- waitlist: anyone can add their number, only admins can read it ----------
    match /waitlist/{id} {
      allow create: if request.resource.data.keys().hasOnly(['phone', 'pincode', 'createdAt'])
        && isPhone(request.resource.data.phone)
        && request.resource.data.pincode is string && request.resource.data.pincode.matches('^[1-9][0-9]{5}$')
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
